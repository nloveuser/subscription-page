APP_PORT=3010

### Remnawave Panel URL, can be http://remnawave:3000 or https://panel.example.com
REMNAWAVE_PANEL_URL=https://remnawave:3000
### Replace with own API Token. Create in Remnawave Dashboard → Remnawave Settings → API Tokens section
REMNAWAVE_API_TOKEN=

# Serve at custom root path, for example, this value can be: CUSTOM_SUB_PREFIX=sub
# Do not place / at the start/end
CUSTOM_SUB_PREFIX=

# If you use "Caddy with security" addon or "Tiny Auth", you can place here X-Api-Key, which will be applied to requests to Remnawave Panel.
# Will be used with "X-Api-Key" header
CADDY_AUTH_API_TOKEN=

# If you use Cloudflare Zero Trust
CLOUDFLARE_ZERO_TRUST_CLIENT_ID=""
CLOUDFLARE_ZERO_TRUST_CLIENT_SECRET=""

# Support Marzban links
MARZBAN_LEGACY_LINK_ENABLED=false
MARZBAN_LEGACY_SECRET_KEY=

# Don't use this unless you know what you are doing!
# Example format: "2025-01-17T15:38:45.065Z"
MARZBAN_LEGACY_SUBSCRIPTION_VALID_FROM=

# ──────────────────────────────────────────────
# Branding overrides (override values from Remnawave panel config)
# ──────────────────────────────────────────────

# Override the brand/service name shown in the header
BRAND_NAME=

# Override the support link (Telegram, website, etc.)
BRAND_SUPPORT_URL=

# Override the logo URL (must be a public image URL)
BRAND_LOGO_URL=

# Override the page <title> and meta description
META_TITLE=
META_DESCRIPTION=

# ──────────────────────────────────────────────
# Theme / Color customization
# ──────────────────────────────────────────────

# Mantine primary color — affects buttons, links, icons.
# Allowed values: cyan (default), blue, green, teal, violet, grape, pink,
#                 red, orange, yellow, lime, indigo, gray, dark
THEME_PRIMARY_COLOR=cyan

# Page background color (hex)
THEME_BG_COLOR=#161b23

# Left radial gradient accent color (named or hex)
THEME_ACCENT_LEFT_COLOR=violet

# Right radial gradient accent color (named or hex)
THEME_ACCENT_RIGHT_COLOR=cyan

# ──────────────────────────────────────────────
# Internal management API (used by Go sidecar)
# ──────────────────────────────────────────────

# Secret token for POST /internal/reload and Go API endpoints.
# If empty — no auth is required (only safe on an internal Docker network).
INTERNAL_API_TOKEN=

# Auto-setup: when true, the Go internal API will automatically create
# a subpage config in the Remnawave panel on startup (if none exists with BRAND_NAME).
# Requires REMNAWAVE_PANEL_URL and REMNAWAVE_API_TOKEN to be set.
RWSP_AUTO_SETUP=false

# ──────────────────────────────────────────────
# MySQL (domain config storage)
# ──────────────────────────────────────────────

MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=rwsp
MYSQL_USER=rwsp
MYSQL_PASSWORD=change_me

# ──────────────────────────────────────────────
# Angie (HTTPS reverse proxy) + certbot
# ──────────────────────────────────────────────

# Email for Let's Encrypt certificate notifications (required for SSL)
ACME_EMAIL=admin@example.com

# Go API automatically writes per-domain Angie conf files and reloads Angie.
# SSL certs are issued via certbot when adding a domain with sslEnabled=true.
